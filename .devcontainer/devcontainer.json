{
  "name": "SaaS AI Model Lab — 32GB",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    }
  },
  "forwardPorts": [3000, 3001, 8880, 8881, 8998, 11434],
  "portsAttributes": {
    "3000": { "label": "Next.js App", "onAutoForward": "notify" },
    "11434": { "label": "Ollama API", "onAutoForward": "silent" },
    "8880": { "label": "Kokoro TTS", "onAutoForward": "silent" },
    "8881": { "label": "Coqui XTTS-v2", "onAutoForward": "silent" },
    "8998": { "label": "Moshi / PersonaPlex", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "rangav.vscode-thunder-client"
      ]
    }
  }
}
